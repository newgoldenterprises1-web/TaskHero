rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function admin(){ return signedIn() && request.auth.token.admin == true; }
    function owner(uid){ return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          "name","phone","fcmToken","fcmTokenUpdatedAt","updatedAt"
        ]);
      allow read: if owner(uid) || admin();
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name","phone","fcmToken","fcmTokenUpdatedAt","updatedAt"
        ]);
      allow delete: if admin();
    }

    match /familyMembers/{id} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "customerId","name","relationship","phone","address","notes","createdAt","updatedAt"
        ]);
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if admin()
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name","relationship","phone","address","notes","updatedAt"
          ]));
      allow delete: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
    }

    match /addresses/{id} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "customerId","address","createdAt","updatedAt"
        ]);
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if admin()
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["address","updatedAt"]));
      allow delete: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
    }

    match /bookings/{id} {
      // Booking creation and lifecycle changes are server-authoritative Cloud Functions.
      allow create: if false;

      allow read: if admin() || (signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      ));

      allow update: if admin()
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photos","updatedAt"]));

      allow delete: if admin();
    }

    match /partners/{uid} {
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          "name","phone","serviceCategories","online","available",
          "approved","activeJobs","rating","createdAt","updatedAt"
        ])
        && request.resource.data.approved == false
        && request.resource.data.activeJobs == 0
        && request.resource.data.rating == 0;
      allow read: if admin() || owner(uid);
      allow update: if admin()
        || (owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name","phone","serviceCategories","online","available","updatedAt"
          ]));
      allow delete: if admin();
    }

    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /securityEvents/{id} {
      allow read, write: if false;
    }

    match /securityRateLimits/{id} {
      allow read, write: if false;
    }

    // Security alerts are backend/admin-callable only. No direct client access.
    match /securityAlerts/{id} {
      allow read, write: if false;
    }

    match /supportTickets/{id} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "customerId","subject","message","status","createdAt","updatedAt"
        ])
        && request.resource.data.status == "open";
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if admin();
    }
  }
}